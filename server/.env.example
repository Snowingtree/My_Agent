# Agent API environment example.
# Copy to server/.env and replace placeholders in your deployment environment.
# Never commit real API keys, passwords, tokens, or app secrets.

# Server
AGENT_HOST=127.0.0.1
AGENT_PORT=3002
AGENT_TIMEZONE=Asia/Shanghai

# Auth
AGENT_AUTH_SECRET=replace-with-long-random-secret
AGENT_ACCESS_TOKEN_TTL_MS=3600000
AGENT_REFRESH_TOKEN_TTL_MS=604800000

# Shared login service used to validate username/password.
AGENT_SHARED_AUTH_BASE_URL=
AGENT_SHARED_AUTH_LOGIN_PATH=/api/login
AGENT_SHARED_AUTH_TIMEOUT_MS=10000

# Storage
AGENT_DATA_DIR=data
AGENT_SESSIONS_DIR=
AGENT_TOKEN_USAGE_FILE=
AGENT_SESSION_ARTIFACTS_DIR=data/session-files
AGENT_SESSION_WORKSPACES_DIR=

# AI config source: mysql, env, or file.
AGENT_AI_CONFIG_SOURCE=mysql
AGENT_AI_CONFIG_PATH=config/ai-configs.json
AGENT_AI_TIMEOUT_MS=120000
AGENT_AI_IDLE_TIMEOUT_MS=30000
AGENT_AI_TIMEOUT_RETRIES=2
AGENT_AI_TIMEOUT_RETRY_DELAY_MS=1500
AGENT_AI_STREAM_RESPONSES=true

# MySQL for AI / embedding configs.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent_user
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=agent
AI_SETTINGS_MYSQL_TABLE=ai_provider_configs

# Optional single AI config when AGENT_AI_CONFIG_SOURCE=env.
AGENT_AI_ID=primary
AGENT_AI_NAME=Primary Model
AGENT_AI_BASE_URL=https://example.com/v1
AGENT_AI_API_KEY=replace-with-ai-api-key
AGENT_AI_MODELS=model-a,model-b
AGENT_AI_MODEL=model-a

# AI API protocol: auto, openai, or anthropic.
# auto detects official Anthropic endpoints, known OpenAI-compatible gateways,
# and falls back to the model name when the endpoint is ambiguous.
AGENT_AI_PROTOCOL=auto
AGENT_ANTHROPIC_VERSION=2023-06-01
AGENT_ANTHROPIC_MAX_TOKENS=8192

# Context memory
AGENT_CONTEXT_MESSAGES=12
AGENT_CONTEXT_MEMORY_ENABLED=true
AGENT_CONTEXT_MEMORY_THRESHOLD=24
AGENT_CONTEXT_MEMORY_KEEP_MESSAGES=12
AGENT_CONTEXT_MEMORY_MIN_BATCH_MESSAGES=4
AGENT_CONTEXT_MEMORY_MAX_CHARS=6000
AGENT_MAX_PLAN_STEPS=5

# Skills
AGENT_SKILLS_CONFIG_PATH=config/skills.json
AGENT_SKILLS_LIBRARY_DIR=../skills
AGENT_DEFAULT_SKILL_ID=

# MCP
AGENT_MCP_ENABLED=true
AGENT_MCP_CONFIG_PATH=mcp/mcp-servers.json
AGENT_MCP_TIMEOUT_MS=30000
AGENT_MCP_PROTOCOL_VERSION=2025-11-25

# Feishu/Lark MCP example. Values are read by mcp/servers/lark.json.
AGENT_LARK_APP_ID=replace-with-lark-app-id
AGENT_LARK_APP_SECRET=replace-with-lark-app-secret
AGENT_LARK_TOOLS=im.v1.message.create,im.v1.message.list,im.v1.chat.create,im.v1.chat.list

# RAG: PostgreSQL + pgvector.
AGENT_RAG_ENABLED=true
AGENT_RAG_DATABASE_URL=postgresql://agent_user:replace-with-postgres-password@127.0.0.1:5432/rag
AGENT_RAG_EMBEDDING_DIM=1024
AGENT_RAG_EMBEDDING_TIMEOUT_MS=30000
AGENT_RAG_MAX_SEARCH_RESULTS=6
AGENT_RAG_CHUNK_MAX_CHARS=1200
AGENT_RAG_CHUNK_OVERLAP_CHARS=160

# Workspace tools
AGENT_WORKSPACE_WRITE_MODE=session
AGENT_WORKSPACE_ROOT=..
AGENT_MAX_FILE_SIZE_BYTES=10485760
AGENT_MAX_WRITE_SIZE_BYTES=1048576
AGENT_MAX_SEARCH_RESULTS=50
AGENT_MAX_COMMAND_OUTPUT_CHARS=12000
AGENT_ALLOWED_COMMANDS=npm,node,git,rg
AGENT_AUTO_VERIFY_AFTER_WRITE=true
AGENT_AUTO_VERIFY_COMMANDS=
AGENT_ENABLE_WRITE_TOOLS=true

# Runtime
AGENT_STEP_DELAY_MS=350
AGENT_TASK_TIMEOUT_MS=900000
AGENT_COMMAND_TIMEOUT_MS=120000
AGENT_MAX_TOOL_ITERATIONS=6
