# These Agent-specific keys take precedence. If omitted, the service also
# accepts the same legacy naming used in your blog project:
# API_HOST, API_PORT, AUTH_TOKEN_SECRET, AUTH_TOKEN_TTL_SECONDS.
AGENT_HOST=127.0.0.1
AGENT_PORT=3002
AGENT_ADMIN_USERNAME=admin
AGENT_ADMIN_PASSWORD=change-me-please
AGENT_AUTH_SECRET=replace-with-a-long-random-string
AGENT_TOKEN_TTL_MS=
AGENT_AI_CONFIG_SOURCE=mysql
AGENT_SKILLS_CONFIG_PATH=
AGENT_DEFAULT_SKILL_ID=general_chat
AGENT_MCP_ENABLED=true
AGENT_MCP_CONFIG_PATH=../mcp/mcp-servers.json
AGENT_MCP_TIMEOUT_MS=30000
AGENT_MCP_PROTOCOL_VERSION=2025-11-25
AGENT_LARK_APP_ID=
AGENT_LARK_APP_SECRET=
AGENT_LARK_TOOLS=preset.im.default,preset.calendar.default,contact.v3.user.batch_get_id,contact.v3.user.get,calendar.v4.calendar_event_attendee.create,calendar.v4.calendar_event_attendee.list
AGENT_RAG_ENABLED=false
AGENT_RAG_DATABASE_URL=
AGENT_RAG_EMBEDDING_DIM=1024
AGENT_RAG_EMBEDDING_BASE_URL=
AGENT_RAG_EMBEDDING_API_KEY=
AGENT_RAG_EMBEDDING_MODEL=
AGENT_RAG_EMBEDDING_PROVIDER=auto
AGENT_RAG_EMBEDDING_TIMEOUT_MS=30000
AGENT_RAG_MAX_SEARCH_RESULTS=6
AGENT_RAG_CHUNK_MAX_CHARS=1200
AGENT_RAG_CHUNK_OVERLAP_CHARS=160
AGENT_WORKSPACE_ROOT=
AGENT_WORKSPACE_WRITE_MODE=session
AGENT_SESSION_WORKSPACES_DIR=/www/wwwroot/wmzh/storage/agent/agent-workspace
AGENT_SESSIONS_DIR=/www/wwwroot/wmzh/storage/agent/sessions
AGENT_ALLOWED_COMMANDS=npm,node,git,rg
AGENT_COMMAND_TIMEOUT_MS=120000
AGENT_MAX_FILE_SIZE_BYTES=262144
AGENT_MAX_WRITE_SIZE_BYTES=524288
AGENT_MAX_SEARCH_RESULTS=50
AGENT_MAX_COMMAND_OUTPUT_CHARS=12000
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_AUTO_VERIFY_AFTER_WRITE=true
AGENT_AUTO_VERIFY_COMMANDS=
AGENT_AUTO_VERIFY_COMMANDS_JSON=
AGENT_ENABLE_WRITE_TOOLS=true
AGENT_AI_TIMEOUT_MS=120000
AGENT_AI_IDLE_TIMEOUT_MS=30000
AGENT_AI_TIMEOUT_RETRIES=2
AGENT_AI_TIMEOUT_RETRY_DELAY_MS=1500
AGENT_AI_STREAM_RESPONSES=true
AGENT_TASK_TIMEOUT_MS=900000

# Shared MySQL connection. The new Agent API can reuse the same database and
# table structure as your blog notes AI config.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Compatible legacy blog env names:
API_HOST=
API_PORT=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=

# Optional: override the AI config table if needed. The default matches the
# blog project: ai_provider_configs
AI_SETTINGS_MYSQL_HOST=
AI_SETTINGS_MYSQL_PORT=
AI_SETTINGS_MYSQL_USER=
AI_SETTINGS_MYSQL_PASSWORD=
AI_SETTINGS_MYSQL_DATABASE=
AI_SETTINGS_MYSQL_TABLE=ai_provider_configs

# Optional: decrypt encrypted api_key values such as enc:v1:...
OPENAI_KEY_ENCRYPTION_SECRET=

# Fallback-only env mode. These are only used when MySQL is not selected.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_AI_MODEL=gpt-4.1-mini
