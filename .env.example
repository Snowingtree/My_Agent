# Frontend environment example.
# Copy to .env.local for local development.
# Do not put real secrets in this file.

# Optional. If empty, frontend requests use the current origin.
VITE_API_BASE_URL=

# Optional. Used when /agent should call a private API base URL.
VITE_PRIVATE_APP_BASE_URL=

# API path prefix in production. The default is /agent-api for the Nginx layout in README.md.
VITE_API_PATH_PREFIX=/agent-api

# Vite dev proxy target.
API_PROXY_TARGET=http://127.0.0.1:3002
